# Port the app is published on at http://localhost:$APP_PORT
APP_PORT=8080

# PostgreSQL credentials (used by both the db and api containers)
DB_NAME=webhooks
DB_USER=webhooks
DB_PASSWORD=webhooks

# Change this before exposing the app outside localhost
JWT_SECRET=dev-only-change-me
# Token lifetime in seconds (12h)
JWT_TTL=43200

# 1 = include exception messages in API 500 responses
APP_DEBUG=0

# Routing worker: how many times a transient failure (network, timeout, 5xx,
# 429) is retried, and the first backoff step in seconds (1s → 2s → 4s).
ROUTING_MAX_ATTEMPTS=3
ROUTING_RETRY_BASE=1
# A `running` run older than this is considered abandoned and requeued.
ROUTING_STALE_MINUTES=5

# Timeout of a `forward` action, in seconds.
FORWARD_TIMEOUT=8

# Forward guard: the router runs inside the private network, so an unrestricted
# forward is an SSRF primitive. Addresses are compared as packed bytes, so every
# spelling of loopback (::1, 0:0:0:0:0:0:0:1, ::ffff:7f00:1) is caught, as is a name
# that only exists in /etc/hosts (ip6-localhost). Refused: 0.0.0.0/8, 127/8,
# 169.254/16 (cloud metadata), multicast, ::, ::1, fe80::/10, ff00::/8. RFC1918 and
# fd00::/8 stay allowed — forwarding to an internal service (`http://web/...`) is a
# normal use case. A name that does not resolve is refused (fail-closed).
# 1 = legacy behaviour, any address is allowed (trusted installation only).
FORWARD_ALLOW_INTERNAL=0
# Extra hosts to refuse, comma-separated (e.g. internal-admin.local).
FORWARD_BLOCKED_HOSTS=

# Circuit breaker per forward address (scheme://host:port), in the worker.
# After FORWARD_BREAKER_THRESHOLD terminal failures in a row the address is
# skipped for FORWARD_BREAKER_COOLDOWN seconds instead of being called by every
# delivery; then one probe is let through to find out whether it is back.
# FORWARD_BREAKER_DEFERRALS bounds how many cooldowns one run may wait out before
# it is finished as `skipped` — a run that is deferred is not an attempt, so
# without a limit a dead address would keep a pending row alive forever.
FORWARD_BREAKER_THRESHOLD=2
FORWARD_BREAKER_COOLDOWN=60
FORWARD_BREAKER_DEFERRALS=3

# Login throttle: attempts per minute, per account (strict) and per address
# (looser, because a whole office shares one address). 0 disables the limiter.
LOGIN_MAX_ATTEMPTS=10
LOGIN_IP_MAX_ATTEMPTS=50
LOGIN_WINDOW_SECONDS=60

# Public catcher throttle: requests per address per window.
# 0 (default) = unlimited, so an upgrade never starts dropping real traffic.
INGEST_MAX_PER_WINDOW=0
INGEST_WINDOW_SECONDS=60

# --- Failure alerting (worker) ------------------------------------------------
# The receiver answers 202 before actions run, so a broken forward target used to
# fail silently. Every terminal failure (after retries) is counted; after this many
# in a row the workflow is paused automatically and the UI explains why.
# 0 = never pause automatically (the counter is still kept).
WORKFLOW_FAILURE_THRESHOLD=3
# Optional notification target (Slack/Discord incoming webhook works as-is: the
# payload carries a `text`). Empty = no notification, counters still work.
ALERT_WEBHOOK_URL=
# At most one "still failing" message per workflow per interval, so an hour-long
# outage does not post a message per webhook. The pause notice is never throttled.
ALERT_COOLDOWN_SECONDS=900

# Retention: 0 keeps everything (an audit log is the product's point).
# RETENTION_DAYS prunes whole requests; RETENTION_RUN_DAYS prunes finished runs of
# requests that are still kept. Both run in the worker, hourly. A request with a
# queued (`pending`/`running`) run is never pruned.
RETENTION_DAYS=0
RETENTION_RUN_DAYS=0
RETENTION_INTERVAL_SECONDS=3600

# Health (`GET /api/health` and the compose healthcheck). The endpoint answers 503
# when the oldest queued run is older than HEALTH_QUEUE_MAX_AGE, and when work is
# waiting but no worker has beaten within WORKER_STALE_SECONDS. A worker that never
# beat on an empty installation is not a failure.
HEALTH_QUEUE_MAX_AGE=300
WORKER_STALE_SECONDS=60

# Demo shortcut on the login page. The credentials are only sent to the client when
# this is 1, so nothing is baked into the JS bundle.
DEMO_LOGIN=1
DEMO_EMAIL=admin@hookdock.local
DEMO_PASSWORD=123456
