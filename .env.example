# Port the app is published on at http://localhost:$APP_PORT
APP_PORT=8080

# PostgreSQL credentials (used by both the db and api containers)
DB_NAME=webhooks
DB_USER=webhooks
DB_PASSWORD=webhooks

# Change this before exposing the app outside localhost
JWT_SECRET=dev-only-change-me
# Token lifetime in seconds (12h)
JWT_TTL=43200

# 1 = include exception messages in API 500 responses
APP_DEBUG=0
